            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (namespace, cache) (rate(cache_server_request_counter{job=\"dacs-cache-server\", namespace=~\"$namespace\", cache=~\"$cache\", request_type=\"Download\", status=\"Success\"}[$__rate_interval]))",
          "legendFormat": "{{namespace}}/{{cache}} hits",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (namespace, cache) (rate(cache_server_request_counter{job=\"dacs-cache-server\", namespace=~\"$namespace\", cache=~\"$cache\", request_type=\"Download\", status=\"InvalidTransition\"}[$__rate_interval]))",
          "legendFormat": "{{namespace}}/{{cache}} misses",
          "refId": "B"
        }
      ],
