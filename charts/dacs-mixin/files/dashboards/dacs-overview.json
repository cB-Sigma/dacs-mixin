          },
          "expr": "sum by (request_type) (rate(cache_server_request_counter{job=\"dacs-cache-server\", namespace=~\"$namespace\", cache=~\"$cache\"}[$__rate_interval]))",
          "legendFormat": "{{request_type}}",
          "refId": "A"
        }
      ],
      "title": "Requests by type",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Request rate by server status. InvalidTransition is not an error: it marks a miss on Download and an already-cached chunk on Upload.",
      "fieldConfig": {
