          },
          "expr": "sum by (namespace, cache) (rate(cache_server_upload_request_size_bytes_sum{job=\"dacs-cache-server\", namespace=~\"$namespace\", cache=~\"$cache\"}[$__rate_interval]))",
          "legendFormat": "{{namespace}}/{{cache}}",
          "refId": "A"
        }
      ],
