      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Download hits divided by download lookups, per cache. Drops are expected right after a cache is created, scaled or restarted without a usable snapshot.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 0,
            "gradientMode": "none",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        },
        "overrides": [

        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "id": 9,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (namespace, cache) (rate(cache_server_request_counter{job=\"dacs-cache-server\", namespace=~\"$namespace\", cache=~\"$cache\", request_type=\"Download\", status=\"Success\"}[$__rate_interval])) / sum by (namespace, cache) (rate(cache_server_request_counter{job=\"dacs-cache-server\", namespace=~\"$namespace\", cache=~\"$cache\", request_type=\"Download\", status=~\"Success|InvalidTransition\"}[$__rate_interval]))",
          "legendFormat": "{{namespace}}/{{cache}}",
          "refId": "A"
        }
      ],
      "title": "Hit ratio by cache",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
