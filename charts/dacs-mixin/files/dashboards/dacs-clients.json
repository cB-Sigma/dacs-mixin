{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "DACS as seen by workloads: cache hits and misses, bytes requested and served, upload volume, DNS failures and client-side latency. Requires cache client metrics, which are off by default and are pushed over OTLP (see docs/client-metrics.md).",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "dacs"
      ],
      "targetBlank": false,
      "title": "DACS dashboards",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [

      ],
      "title": "About this dashboard",
      "type": "row"
    },
    {
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "content": "Cache client metrics are **opt-in** (`STORAGE_METRIC_OTEL_ENABLED=true`) and are **pushed** over OTLP/HTTP every 5 minutes by default, so rates here use the long **Rate window** variable instead of the scrape interval.\nThe series names assume the standard OTLP to Prometheus translation (`_total` on counters) and `service.name` mapped to `job`. If your pipeline differs, re-render the mixin with other settings. Client metrics carry no cache label; use one service name per workload to tell them apart.\n",
        "mode": "markdown"
      },
      "title": "Read me",
      "type": "text"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 3,
      "panels": [

      ],
      "title": "Cache effectiveness",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Client-side hits divided by hits plus misses. A miss means the client went on to read the chunk from Blob Storage.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 0,
            "gradientMode": "none",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        },
        "overrides": [

        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (job) (rate(cache_client_download_cache_hits_total{job=~\"$workload\"}[$window])) / (sum by (job) (rate(cache_client_download_cache_hits_total{job=~\"$workload\"}[$window])) + sum by (job) (rate(cache_client_download_cache_misses_total{job=~\"$workload\"}[$window])))",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "title": "Hit ratio by workload",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Download outcomes per workload. Downloads that fail with a transport or server error are in neither series.",
